{
  "expo": {
    "name": "KONEX",
    "slug": "konex",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "konex",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.konex.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.konex.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KONEX to access your photos to share clips and images.",
          "cameraPermission": "Allow KONEX to use your camera."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow KONEX to access your microphone for calls and voice."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "98e59225-51dc-4c70-95dd-7293dee1b118"
      }
    },
    "owner": "desmond1010"
  }
}